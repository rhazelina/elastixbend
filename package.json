{
  "name": "elastixbend",
  "version": "0.1.0",
  "description": "Elastic scroll displacement that never hijacks scroll.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "DECISIONS.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:react": "node measure/size.mjs",
    "measure": "node measure/perf.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run size && npm run size:react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^14.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
