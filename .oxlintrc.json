{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "ignorePatterns": [
    "dist",
    "playground-dist",
    "docs/.vitepress/dist",
    "docs/.vitepress/cache",
    "docs/node_modules"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/react.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
